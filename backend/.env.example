# Copy this file to ".env" (same folder) and fill in values for local development.
# ".env" is gitignored and must never be committed.
#
# Local admin seeding (Phase 0 only). If KUBEMIND_ADMIN_PASSWORD is empty or missing,
# no admin user is created at startup.
KUBEMIND_ADMIN_USERNAME=admin
KUBEMIND_ADMIN_PASSWORD=

# Encryption key for kubeconfigs stored at rest (multi-cluster, Phase 5).
# Generate with:  openssl rand -base64 32
# Without it the app runs, but remote clusters cannot be registered.
KUBEMIND_ENCRYPTION_KEY=

# OIDC/SSO login (optional, additive — local username/password login above
# keeps working either way). Without KUBEMIND_OIDC_ISSUER_URI set, none of
# this exists: no "Sign in with SSO" button, no /oauth2/* routes.
#
# An unreachable identity provider does NOT stop KubeMind starting: discovery
# happens on the first SSO click, not at boot, so an IdP outage costs you SSO
# and nothing else. Local login stays available throughout — which is the whole
# reason to keep an admin password configured alongside SSO.
# KUBEMIND_OIDC_ISSUER_URI=https://your-idp.example.com/realms/kubemind
# KUBEMIND_OIDC_CLIENT_ID=kubemind
# KUBEMIND_OIDC_CLIENT_SECRET=
# First login for a given identity creates a local user row (role USER by
# default). Optional: a group in KUBEMIND_OIDC_GROUPS_CLAIM (default "groups")
# that gets ADMIN instead, checked only at that first login — an ADMIN
# changes anyone's role afterward the same way as for a local user.
# KUBEMIND_OIDC_GROUPS_CLAIM=groups
# KUBEMIND_OIDC_ADMIN_GROUP=

# Kubernetes user impersonation against the built-in cluster (id 0). When true,
# calls carry the caller's identity (Impersonate-User/Impersonate-Group) instead
# of this install's ServiceAccount, Kubernetes RBAC decides what each person can
# do, and cluster 0 opens to all logged-in users instead of ADMINs only.
#
# Needs a ServiceAccount that may impersonate, AND an RBAC binding per user —
# the local admin included. Grant that BEFORE switching this on, or cluster 0
# goes blank for everyone:
#   kubectl create clusterrolebinding kubemind-admin \
#     --clusterrole=cluster-admin --user=admin
# KUBEMIND_IMPERSONATION_ENABLED=false

# Optional: override the database connection (defaults target local Postgres on 5432).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kubemind
# SPRING_DATASOURCE_USERNAME=kubemind
# SPRING_DATASOURCE_PASSWORD=kubemind

# Optional: AI model endpoint (defaults to the native Ollama app on 11434).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
