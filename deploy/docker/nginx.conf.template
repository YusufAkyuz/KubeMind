# Serves the built SPA and reverse-proxies API/WebSocket traffic to the backend
# service — the single in-cluster entrypoint the ingress targets. Listens on 8080
# so the container runs as nginx's unprivileged user without CAP_NET_BIND_SERVICE.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA deep links (/clusters/0/nodes etc.) must fall back to index.html —
    # React Router owns routing client-side.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-lived immutable assets (Vite emits content-hashed filenames).
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE (live watch streams) and streaming AI responses die if nginx
        # buffers them; long AI generations also outlive the default 60s.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # OIDC login (when configured — see KubemindOidcProperties): the browser
    # is redirected here directly, not fetched via axios, so these need their
    # own location blocks alongside /api/ rather than falling under it.
    location /oauth2/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # More specific than the SPA's own /login route below, so nginx's
    # longest-prefix match sends only the OIDC callback here.
    location /login/oauth2/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Interactive terminals (pod exec, node shell, cluster terminal).
    location /ws/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Kubernetes probes hit the backend's actuator through this same entrypoint.
    location /actuator/health {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    }
}
